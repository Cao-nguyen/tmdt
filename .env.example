# Cấu hình ứng dụng Laravel
APP_NAME="Laravel Supabase"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tmdt.test

# Cấu hình Database Supabase (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=db.xxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# Cấu hình Supabase API
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cấu hình Cache và Session
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Cấu hình cho Laragon
LOG_CHANNEL=daily
LOG_LEVEL=debug
